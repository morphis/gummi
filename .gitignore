# build output
/bin/
/dist/

# test and profiling artifacts
*.out
*.test

# gummi's own runtime workspace when dogfooding in this repo
/.gummi/

# editor droppings
*.swp
.DS_Store

# workshop container lockfile
.workshop.lock

# copilot CLI logs when dogfooding
.copilot/

# stray root binary from `go build .`
/gummi

# snapcraft results
/results/

# the recorded walkthrough: too big for history, and `make record-demo`
# rebuilds it (and the README gif, which IS tracked) from scratch
/docs/assets/*.mp4
/docs/assets/*.bak
