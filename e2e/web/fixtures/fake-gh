#!/usr/bin/env python3
"""A stand-in for the `gh` CLI, answering exactly the calls gummi makes.

gummi reaches gh through GUMMI_GH_CMD (internal/pr: pr link/status/comments,
the board's PR tab, the squash-merge check) and through plain `gh` on PATH
(internal/engine/bugsource.go: bug import). The suite points the first at
this file and puts a `gh` symlink to it first on PATH for the second.

Answers come from JSON files in $FAKE_GH_DATA (default: the gh/ directory
next to this script). A test that needs a different answer writes its own
file into the workspace's copy of that directory:

    pr-<N>.json        `gh pr view <N> --json <fields>` (fields are picked
                       out of the file's object)
    pr-list.json       `gh pr list --head <branch> --json <fields>` (filtered
                       on headRefName)
    threads-<N>.json   `gh api graphql ... -F number=<N>` (review threads)
    repo.json          `gh api repos/<owner>/<repo>` (squash-merge setting)
    job-<N>.log        `gh run view --job <N> --log-failed` (the failed
                       steps' log, printed as it is)
    repo-view.json     `gh repo view <owner>/<repo> --json <fields>`; without
                       the file the viewer has WRITE on a repository
                       that is no fork
    signed-out         (any content) makes `gh auth status` fail, as a gh
                       nobody logged in to does
    issues.json        `gh issue list` (filtered on --state and --label,
                       capped by --limit) and `gh issue view <N>`; a
                       --repo ending in /missing fails as an unknown
                       repository does

Publishing (internal/publish) writes as well as reads, so those calls keep
state in the same directory: `gh pr create` writes a new pr-<N>.json
(numbered from 12) and adds it to pr-list.json, `gh pr edit` and `gh pr
ready [--undo]` rewrite it. A PR made that way reads its head back from
the stand-in remote ($FAKE_GH_REMOTE/<owner>/<repo>.git, the bare
repository fake-ssh serves), so it follows what was really pushed.

A missing file answers the way gh does when the thing is not there: a
message on stderr and exit 1. Every invocation is appended, one JSON array
of argv per line, to $FAKE_GH_LOG when it is set, so a test can assert what
gummi asked for.
"""

import json
import os
import subprocess
import sys

HERE = os.path.dirname(os.path.realpath(__file__))
DATA = os.environ.get("FAKE_GH_DATA") or os.path.join(HERE, "gh")


def fail(msg, code=1):
    sys.stderr.write(msg + "\n")
    sys.exit(code)


def load(name):
    path = os.path.join(DATA, name)
    try:
        with open(path, encoding="utf-8") as fh:
            return json.load(fh)
    except FileNotFoundError:
        return None


def save(name, obj):
    with open(os.path.join(DATA, name), "w", encoding="utf-8") as fh:
        json.dump(obj, fh, indent=2)


def remote_tip(repo, branch):
    """The branch's tip in the stand-in remote, "" when it has none."""
    root = os.environ.get("FAKE_GH_REMOTE")
    if not root or not repo:
        return ""
    r = subprocess.run(
        ["git", "--git-dir", os.path.join(root, repo + ".git"), "rev-parse", "--verify", "-q", "refs/heads/" + branch],
        capture_output=True, text=True, check=False)
    return r.stdout.strip() if r.returncode == 0 else ""


def live(data):
    """A PR `gh pr create` made, with its head as the remote has it now."""
    if data.get("fake"):
        tip = remote_tip(data.get("headRepository"), data.get("headRefName", ""))
        if tip:
            data["headRefOid"] = tip
    return data


def out(obj):
    sys.stdout.write(json.dumps(obj) + "\n")


def flag(args, name, default=None):
    """The value of --name / -n in args (both `--x v` and `--x=v`)."""
    for i, a in enumerate(args):
        if a == name and i + 1 < len(args):
            return args[i + 1]
        if a.startswith(name + "="):
            return a[len(name) + 1:]
    return default


def fields(args):
    raw = flag(args, "--json")
    return [f for f in raw.split(",") if f] if raw else None


def pick(obj, wanted):
    if wanted is None:
        return obj
    return {k: obj[k] for k in wanted if k in obj}


def positional(args):
    """The first argument that is neither a flag nor a flag's value."""
    skip = False
    for a in args:
        if skip:
            skip = False
            continue
        if a.startswith("-"):
            skip = "=" not in a and a not in ("--paginate", "--auto", "--draft", "--undo")
            continue
        return a
    return None


def pr(args):
    sub, rest = args[0], args[1:]
    if sub == "view":
        number = positional(rest)
        data = load("pr-%s.json" % number)
        if data is None:
            fail("GraphQL: Could not resolve to a PullRequest with the number of %s. (repository.pullRequest)" % number)
        out(pick(live(data), fields(rest)))
    elif sub == "list":
        head = flag(rest, "--head")
        data = load("pr-list.json") or []
        if head:
            data = [p for p in data if p.get("headRefName") == head]
        out([pick(p, fields(rest)) for p in data])
    elif sub == "create":
        repo, head = flag(rest, "--repo"), flag(rest, "--head", "")
        owner, _, branch = head.rpartition(":")
        owner = owner or (repo or "/").split("/")[0]
        listed = load("pr-list.json") or []
        number = max([11] + [p.get("number", 0) for p in listed]) + 1
        made = {
            "fake": True,
            "number": number,
            "url": "https://github.com/%s/pull/%d" % (repo, number),
            "state": "OPEN",
            "isDraft": "--draft" in rest,
            "headRefOid": "",
            "headRefName": branch,
            "headRepository": "%s/%s" % (owner, (repo or "/").split("/")[1]),
            "baseRefName": flag(rest, "--base", ""),
            "isCrossRepository": owner != (repo or "/").split("/")[0],
            "headRepositoryOwner": {"login": owner},
            "title": flag(rest, "--title", ""),
            "body": sys.stdin.read() if flag(rest, "--body-file") == "-" else "",
            "comments": [],
        }
        if not remote_tip(made["headRepository"], branch):
            fail("pull request create failed: GraphQL: Head sha can't be blank, Head ref must be a branch (createPullRequest)")
        save("pr-%d.json" % number, live(made))
        save("pr-list.json", listed + [made])
        print(made["url"])
    elif sub in ("edit", "ready"):
        number = positional(rest)
        data = load("pr-%s.json" % number)
        if data is None:
            fail("GraphQL: Could not resolve to a PullRequest with the number of %s. (repository.pullRequest)" % number)
        if sub == "ready":
            data["isDraft"] = "--undo" in rest
        else:
            if flag(rest, "--title") is not None:
                data["title"] = flag(rest, "--title")
            if flag(rest, "--body-file") == "-":
                data["body"] = sys.stdin.read()
        save("pr-%s.json" % number, data)
        print(data["url"])
    else:
        fail("fake-gh: unsupported `gh pr %s`" % sub)


def api(args):
    target = positional(args)
    if target == "graphql":
        number = None
        for i, a in enumerate(args):
            if a in ("-F", "-f") and i + 1 < len(args) and args[i + 1].startswith("number="):
                number = args[i + 1].split("=", 1)[1]
        data = load("threads-%s.json" % number)
        if data is None:
            data = {"data": {"repository": {"pullRequest": {
                "headRefOid": "", "reviewThreads": {"nodes": [], "pageInfo": {"hasNextPage": False}},
                "comments": {"nodes": []}, "reviews": {"nodes": []}}}}}
        out(data)
    elif target and target.lstrip("/").startswith("repos/"):
        data = load("repo.json")
        if data is None:
            fail("gh: Not Found (HTTP 404)")
        out(data)
    else:
        fail("gh: Not Found (HTTP 404)")


def repo(args):
    sub, rest = args[0], args[1:]
    if sub != "view":
        fail("fake-gh: unsupported `gh repo %s`" % sub)
    data = load("repo-view.json") or {
        "nameWithOwner": positional(rest), "viewerPermission": "WRITE", "isFork": False, "parent": None}
    out(pick(data, fields(rest)))


def run(args):
    sub, rest = args[0], args[1:]
    if sub != "view":
        fail("fake-gh: unsupported `gh run %s`" % sub)
    job = flag(rest, "--job")
    try:
        with open(os.path.join(DATA, "job-%s.log" % job), encoding="utf-8") as fh:
            sys.stdout.write(fh.read())
    except FileNotFoundError:
        fail("failed to get job: HTTP 404: Not Found (https://api.github.com/repos/%s/actions/jobs/%s)" % (flag(rest, "--repo"), job))


def issue(args):
    sub, rest = args[0], args[1:]
    issues = load("issues.json") or []
    repo = flag(rest, "--repo") or flag(rest, "-R")
    if repo and repo.endswith("/missing"):
        fail("GraphQL: Could not resolve to a Repository with the name '%s'. (repository)" % repo)
    if sub == "list":
        state = (flag(rest, "--state", "open") or "open").lower()
        label = flag(rest, "--label")
        limit = int(flag(rest, "--limit", "30"))
        if state != "all":
            issues = [i for i in issues if i.get("state", "").lower() == state]
        if label:
            issues = [i for i in issues if any(l.get("name") == label for l in i.get("labels", []))]
        out([pick(i, fields(rest)) for i in issues[:limit]])
    elif sub == "view":
        number = positional(rest)
        match = [i for i in issues if str(i.get("number")) == str(number)]
        if not match:
            fail("GraphQL: Could not resolve to an issue or pull request with the number of %s." % number)
        out(pick(match[0], fields(rest)))
    else:
        fail("fake-gh: unsupported `gh issue %s`" % sub)


def main(argv):
    log = os.environ.get("FAKE_GH_LOG")
    if log:
        with open(log, "a", encoding="utf-8") as fh:
            fh.write(json.dumps(argv) + "\n")
    if not argv or argv[0] in ("--version", "version"):
        print("gh version 2.99.0 (fake-gh for gummi's e2e suite)")
        return
    cmd, rest = argv[0], argv[1:]
    if cmd == "pr" and rest:
        pr(rest)
    elif cmd == "api" and rest:
        api(rest)
    elif cmd == "issue" and rest:
        issue(rest)
    elif cmd == "repo" and rest:
        repo(rest)
    elif cmd == "run" and rest:
        run(rest)
    elif cmd == "auth":
        if os.path.exists(os.path.join(DATA, "signed-out")):
            fail("You are not logged into any GitHub hosts. To log in, run: gh auth login")
        print("github.com\n  ✓ Logged in to github.com account e2e (fake-gh)")
    else:
        fail("fake-gh: unsupported `gh %s`" % " ".join(argv))


if __name__ == "__main__":
    main(sys.argv[1:])
